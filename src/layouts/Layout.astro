---
import '../styles/global.css';
import '@fontsource-variable/inter';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  project?: string;
}

const { title, project } = Astro.props;
---
<html lang="en" data-project={project}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-base text-ink font-sans antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
  </body>
</html>