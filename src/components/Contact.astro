---
import { profile } from '../data/profile';
---
<footer id="contact" class="border-t border-white/10">
  <div class="mx-auto max-w-6xl px-6 py-32 text-center lg:px-24">
    <div class="reveal">
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-muted">Contact</p>
      <h2 class="text-4xl font-semibold tracking-tight md:text-6xl">
        Let's build something <span class="text-muted">intelligent.</span>
      </h2>
      <a
        href={`mailto:${profile.email}`}
        class="mt-10 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-black transition hover:scale-105"
      >
        Get in touch <span aria-hidden="true">→</span>
      </a>
      <ul class="mt-8 flex justify-center gap-8 text-sm text-muted">
        <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">LinkedIn</a></li>
        <li><a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ink">Download CV</a></li>
      </ul>
    </div>
    <p class="mt-24 text-xs text-muted/60">© 2026 {profile.name}.</p>
  </div>
</footer>