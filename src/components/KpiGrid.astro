---
import type { Kpi } from '../data/experiences';

interface Props {
  kpis: Kpi[];
}

const { kpis } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 py-16 lg:px-24">
  <div class="grid gap-6 md:grid-cols-3">
    {kpis.map((kpi, i) => (
      <div class="reveal" style={`transition-delay: ${i * 120}ms`}>
        <div class="h-full rounded-3xl border border-white/10 bg-surface p-8 transition duration-300 hover:scale-[1.03] hover:border-accent/50">
          <p class="text-5xl font-semibold tracking-tight text-accent md:text-6xl">{kpi.value}</p>
          <p class="mt-4 text-lg font-medium">{kpi.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">{kpi.detail}</p>
        </div>
      </div>
    ))}
  </div>
</section>