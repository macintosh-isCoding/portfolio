---
import { journey } from '../data/journey';
import { experiences } from '../data/experiences';

const steps = journey.map((step) => {
  const experience = experiences.find((e) => e.slug === step.slug);
  return {
    ...step,
    color: experience?.color ?? '#f5f5f7',
    href: experience ? `/experiences/${experience.slug}` : undefined,
  };
});
---
<section id="journey" class="mx-auto max-w-6xl px-6 py-32 lg:px-24">
  <div class="reveal">
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-muted">Journey</p>
    <h2 class="text-4xl font-semibold tracking-tight md:text-6xl">
      The path <span class="text-muted">so far.</span>
    </h2>
  </div>

  <ol class="relative mt-16 border-l border-white/10 pl-8 md:pl-12">
    {steps.map((step) => (
      <li class="reveal relative pb-12 last:pb-0" style={`--accent: ${step.color}`}>
        <span class="absolute -left-[2.4rem] top-6 h-3 w-3 rounded-full bg-accent ring-4 ring-base md:-left-[3.4rem]"></span>
        <div class="group rounded-3xl border border-white/10 bg-surface p-6 transition duration-300 hover:scale-[1.02] hover:bg-white/10">
          <p class="text-sm text-muted">{step.period}</p>
          <h3 class="mt-1 text-xl font-semibold tracking-tight">{step.title}</h3>
          <p class="text-sm font-medium text-accent">{step.place}</p>
          <p class="mt-3 text-muted">{step.text}</p>
          {step.href && (
            <a href={step.href} class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
              Read more
              <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>