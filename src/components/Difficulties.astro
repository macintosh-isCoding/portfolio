---
import type { Block } from '../data/experiences';

interface Props {
  items: Block[];
}

const { items } = Astro.props;
---
<section class="mx-auto max-w-6xl px-6 py-24 lg:px-24">
  <div class="reveal">
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-accent">Challenges</p>
    <h2 class="text-3xl font-semibold tracking-tight md:text-5xl">
      What got in the way<span class="text-muted">.</span>
    </h2>
  </div>

  <div class="mt-12 max-w-3xl space-y-4">
    {items.map((item, i) => (
      <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
        <details
          open={i === 0}
          class="group rounded-3xl border border-white/10 bg-surface transition duration-300 hover:border-accent/50 open:bg-white/5"
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-lg font-medium [&::-webkit-details-marker]:hidden">
            {item.title}
            <span aria-hidden="true" class="text-2xl leading-none text-accent transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <p class="px-6 pb-6 leading-relaxed text-muted">{item.text}</p>
        </details>
      </div>
    ))}
  </div>
</section>